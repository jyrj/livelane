# Pinned upstream commits for the tools these nodes shell out to.
# Every SHA was resolved from the real remote; floating on HEAD would make
# "proven" a statement about whatever was pushed that morning.

# --- Tools the nodes shell out to --------------------------------------------
OPENSTA_URL=https://github.com/parallaxsw/OpenSTA
OPENSTA_REF=737b52f33b66e4c2ccc3e3ef22c3adfe9aec8d09

EQY_URL=https://github.com/YosysHQ/eqy
EQY_REF=4a72eb94fc253062464afee4d0018359017bb846

SBY_URL=https://github.com/YosysHQ/sby
SBY_REF=b1a1e98cba941ec8433f8dc27f416cd7bb7f14be

SV2V_URL=https://github.com/zachjs/sv2v
SV2V_REF=493a88f930802da68f592c192ec86991eaf95c49       # HEAD > v0.0.13

# --- Host tools already present (recorded for provenance, not built) ---------
# yosys 0.67+post (22c15a7ecd53437f18f67c72572bd693f78357ca)
# verilator 5.046

# =============================================================================
# From-source toolchain (built into tools/ prefix; NO system packages installed)
# Resolved from the real remotes on 2026-09-03.
# =============================================================================

# Yosys at EXACTLY the commit Fedora's yosys-0.67+post was built from
# (rpm: yosys-0.67-2.20260713git22c15a7.fc44 -> upstream 22c15a7e, = v0.67-31-g22c15a7ec).
# Building this exact commit keeps QoR results reproducible AND
# gives us the yosys headers that the Fedora package omits, which eqy's plugin needs.
YOSYS_URL=https://github.com/YosysHQ/yosys
YOSYS_REF=22c15a7ecd53437f18f67c72572bd693f78357ca
YOSYS_DESCRIBE=v0.67-31-g22c15a7ec

# libffi: yosys plugin support (ENABLE_PLUGINS) needs ffi.h, absent on this host.
# eqy ships a yosys plugin (eqy_combine.so), so plugins are NOT optional for us.
LIBFFI_URL=https://github.com/libffi/libffi
LIBFFI_REF=v3.5.2

# Eigen 3.4.x (header-only) -- OpenSTA's find_package(Eigen3 REQUIRED).
# Pinned to the 3.4 series, not 5.x, which OpenSTA has not been validated against.
EIGEN_URL=https://gitlab.com/libeigen/eigen
EIGEN_REF=3.4.1

# SWIG (+ its PCRE2 dependency) -- OpenSTA's find_package(SWIG 3.0 REQUIRED)
# generates the TCL bindings.
PCRE2_URL=https://github.com/PCRE2Project/pcre2
PCRE2_REF=pcre2-10.48
SWIG_URL=https://github.com/swig/swig
SWIG_REF=v4.5.0

# Yices 2 -- the SMT engine sby/eqy drive for the equivalence gate. Needs gmp.h,
# which IS present on this host.
YICES_URL=https://github.com/SRI-CSL/yices2
YICES_REF=yices-2.7.0

# Verilator pinned to the version already recorded in the host provenance, so the
# shared functional oracle matches what the 2026-09-02 baseline ran with.
VERILATOR_URL=https://github.com/verilator/verilator
VERILATOR_REF=v5.046

# NOTE on OpenSTA/TCL: this host has tcl-devel 9.0.2 and OpenSTA carries explicit
# TCL 9 guards (include/sta/TclTypeHelpers.hh:32, tcl/StaTclTypes.i:57), so no TCL
# is built from source.
#
# NOTE on sv2v: lhdsuite ships XiangShan as .sv generated by CIRCT firtool, using
# packed structs in port declarations, which Yosys cannot read natively. The
# 2026-09-02 baseline converted them with sv2v, so sv2v is required to reproduce
# it. The tuned candidate additionally evaluates the yosys-slang
# plugin as an alternative front end that preserves hierarchy.

# CUDD -- a REQUIRED OpenSTA dependency (README.md:110), used for conditional
# timing arcs, constant propagation and power activity propagation.
CUDD_URL=https://github.com/cuddorg/cudd
CUDD_REF=cudd-3.0.0

# gperf -- REQUIRED by the yices2 build ("gperf version 3.0 or higher is required").
# Not a git project; pinned by the published sha256 of the GNU release tarball.
GPERF_URL=https://ftp.gnu.org/gnu/gperf/gperf-3.1.tar.gz
GPERF_SHA256=588546b945bba4b70b6a3a616e80b4ab466e3f33024a352fc2198112cdbb3ae2

# help2man -- verilator's `make install` generates man pages with it and fails
# with "Error 127" without it, even though every binary has already linked.
HELP2MAN_URL=https://ftp.gnu.org/gnu/help2man/help2man-1.49.3.tar.xz
HELP2MAN_SHA256=4d7e4fdef2eca6afe07a2682151cea78781e0a4e8f9622142d9f70c083a2fd4f

# =============================================================================
# kepler-formal -- SECOND, INDEPENDENT equivalence backend (GPL-3.0).
# Resolved from the real remotes on 2026-09-14.
#
# WHY a second backend: eqy does gate-level/partition LEC and REQUIRES unchanged
# sequential boundaries. Kepler additionally does RTL-level Sequential
# Equivalence Checking through extracted transition systems, which covers the
# retiming / pipeline-restructuring / register-merge edits eqy structurally
# cannot prove. Two independent checkers also let the gate cross-check, and a
# disagreement between them is itself a reportable result.
# =============================================================================

# --- kepler-formal's own dependencies, built from source into tools/ ---------
# The host has boost 1.90 (>= the 1.87 slang wants), zlib, gmp, bison 3.8.2 and
# flex 2.6.4. capnproto, TBB, fmt and tomlplusplus are ABSENT and are built here.
#
# fmt and tomlplusplus are pinned to the EXACT versions slang's
# external/CMakeLists.txt would otherwise FetchContent from the network
# (fmt 12.2.0, tomlplusplus v3.4.0); building them into the prefix makes
# find_package intercept the fetch, so the build is offline-reproducible.

# --- second equivalence backend (optional; enables cross_check) --------------
# kepler-formal additionally does RTL-level sequential equivalence checking,
# which covers retiming and register-merge edits that partition-based gate-level
# checking structurally cannot. Its dependencies are pinned to the exact versions
# its build would otherwise fetch from the network, so the build is offline-
# reproducible.
KEPLER_URL=https://github.com/keplertech/kepler-formal
KEPLER_REF=f70c2e38592d704c8cccf68433b091e82c8118f0
ONETBB_URL=https://github.com/uxlfoundation/oneTBB
ONETBB_REF=3046c8b0c29df995980003ea24f4d78c80ec0c8d      # tag v2023.1.0
CAPNPROTO_URL=https://github.com/capnproto/capnproto
CAPNPROTO_REF=373e61ec89e2359f1c362e9b2eadc552f4779306    # tag v1.5.0
FMT_URL=https://github.com/fmtlib/fmt
FMT_REF=1be298e1bd68957e4cd352e1f676f00e07dcfb57          # tag 12.2.0
TOMLPLUSPLUS_URL=https://github.com/marzer/tomlplusplus
TOMLPLUSPLUS_REF=30172438cee64926dc41fdd9c11fb3ba5b2ba9de # tag v3.4.0
