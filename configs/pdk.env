# sky130 PDK, the SAME Liberty for BOTH lanes, or area and delay are not
# comparable. Paths are DERIVED, not hardcoded: a hardcoded /home/<user>/...
# makes the repo unusable for anyone who clones it.
#
# lhd resolves $HAGENT_TECH_DIR/sky130_fd_sc_hd__tt_025C_1v80.lib
# (lhd_kernel_synth.cpp:94, lhd.hpp:521); lane S is pointed at the identical file.
export CIEL_PDK_VERSION=1689ac3f2dc763876eaf967227c7dfe831b031ae
export CIEL_ROOT="${CIEL_ROOT:-$HOME/.ciel}"
export HAGENT_TECH_DIR="$CIEL_ROOT/ciel/sky130/versions/$CIEL_PDK_VERSION/sky130A/libs.ref/sky130_fd_sc_hd/lib"
export LIVELANE_LIBERTY="$HAGENT_TECH_DIR/sky130_fd_sc_hd__tt_025C_1v80.lib"
# Pinned content hash: any Liberty that does not match this is a different PDK
# and its numbers are not comparable with ours.
export LIVELANE_LIBERTY_SHA256=8e78e14442062dba34d414fca6490b2f6b96038d4510d1438ca44fee31487135
