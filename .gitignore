# Third-party sources: pinned in configs/pins.env, cloned by
# scripts/setup/10_clone_thirdparty.sh. Never committed.
/thirdparty/

# The from-source toolchain prefix, built by scripts/build/toolchain.sh.
/tools/

# Runtime artifacts: logs, build logs, databases, workdirs, caches.
/var/

# Yosys/ABC/eqy leftovers that land in whatever directory they were run from.
abc.history
/pp.v
/pp-mem.il
*.eqy.log
miter_log_*.txt
naja_sv_diagnostics.log

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Editor
.vscode/
.idea/

# Cloud account values for the Vertex AI agent seat. Never committed.
/configs/gcp.local.env

# Only the paper's own PDF is committed.
*.pdf
!paper/livelane.pdf

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls

# Frozen copies of the harness taken at the start of a measurement campaign, so
# every arm provably runs identical code. Regenerated by the run scripts.
scripts/chia/_*.py

# Run-time logs written next to the checkout by agent runs
/*-cache.log
