+// A partition name that is safe to use as a FILENAME component.
+//
+// Partition names are hierarchical signal paths. CVA6's FPU nests generate
+// blocks deeply enough to produce names past the 255-byte filename limit:
+//
+//   ERROR: Can't open file `partitions/cva6.ex_stage_i.fpu_gen.fpu_i.fpu_gen.
+//   i_fpnew_bulk.gen_operation_groups.3.i_opgroup_block.gen_merged_slice.
+//   i_multifmt_slice.gen_num_lanes.0.active_lane.lane_instance.
+//   i_fpnew_cast_multi.fmt_init_inputs.1.active_format.i_fpnew_classifier.
+//   gen_num_values.0.value.63.json' for writing: File name too long
+//
+// which aborted the whole run after 214,903 partitions had already been
+// generated. sby also nests the name twice inside its own directories, so the
+// budget is tighter than 255.
+//
+// Shortening keeps a readable head and appends a digest of the FULL name, so
+// it stays deterministic across runs and cannot collide. The same shortened
+// string is used for the filename, for `partition.list` and for the module id,
+// so every consumer agrees.
+static std::string ll_safe_partname(const std::string &name, size_t limit = 100)
+{
+	if (name.size() <= limit)
+		return name;
+	// FNV-1a over the full name: no external dependency, stable everywhere.
+	uint64_t h = 1469598103934665603ULL;
+	for (unsigned char c : name) { h ^= c; h *= 1099511628211ULL; }
+	// Keep the tail rather than the head: the leaf signal is what identifies
+	// a partition to a human, while the shared hierarchy prefix is noise.
+	std::string tail = name.substr(name.size() - (limit - 20));
+	return stringf("~%016llx~%s", (unsigned long long)h, tail.c_str());
+}
