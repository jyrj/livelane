+// --- LiveLane instrumentation -------------------------------------------
+// eqy_partition is 90% of eqy's setup step and superlinear in design size
+// (590 -> 5,261 -> 16,065 partitions costs ~1.5s -> 15s -> 144s), and it does
+// not terminate at all on a whole CVA6 core. Before trying to make it
+// incremental we need to know WHICH phase costs, so each phase is timed and
+// reported. Enabled by EQY_PARTITION_PROFILE=1 so default behaviour and
+// default log output are unchanged.
+static double ll_now()
+{
+	return std::chrono::duration<double>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+static bool ll_profile()
+{
+	static int on = -1;
+	if (on < 0) { const char *e = getenv("EQY_PARTITION_PROFILE"); on = (e && *e && *e != '0') ? 1 : 0; }
+	return on == 1;
+}
+static bool ll_want_matrix()
+{
+	static int on = -1;
+	if (on < 0) { const char *e = getenv("EQY_PARTITION_MATRIX"); on = (e && *e && *e != '0') ? 1 : 0; }
+	return on == 1;
+}
+static void ll_phase(const char *name, double t0, double t1, long long n = -1)
+{
+	if (!ll_profile()) return;
+	// stderr, NOT log(): the profile must survive `yosys -q`, because whether
+	// logging itself is the cost is one of the things being measured. Routing
+	// the measurement through the thing under test would hide exactly that.
+	if (n >= 0)
+		fprintf(stderr, "LL-PROFILE %-26s %9.3f s   n=%lld\n", name, t1 - t0, n);
+	else
+		fprintf(stderr, "LL-PROFILE %-26s %9.3f s\n", name, t1 - t0);
+	fflush(stderr);
+}
