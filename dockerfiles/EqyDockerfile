# Dockerfile for chia/formal/lec_gate.py workers.
#
# Carries the YosysHQ equivalence-checking stack: yosys (with plugin support),
# eqy, sby, yosys-smtbmc, and two independent SMT solvers (yices2, z3).
#
# Builds ON TOP of ghcr.io/ucb-bar/chia (rayproject/ray + the chia package), so
# chia and a matching Ray/Python are already installed.
#
#   docker build -f dockerfiles/EqyDockerfile \
#       -t ghcr.io/ucb-bar/chia-eqy:latest .
#
# Bind it to the node with the resource token, which is the ONLY link between a
# @ChiaFunction and a container image:
#
#   available_node_types:
#     eqy_worker:
#       resources: {"eqy": 1}
#       docker:
#         image: "ghcr.io/ucb-bar/chia-eqy:latest"
#
#   @ChiaFunction(resources={"eqy": 1})    # chia/formal/lec_gate.py
#   def lec_gate(...)
#
# Smoke-test a built image:
#   docker run --rm ghcr.io/ucb-bar/chia-eqy:latest \
#       bash -lc 'eqy --version && yosys -V && yices-smt2 --version'
#
# WHY FROM SOURCE, and why these exact commits
# --------------------------------------------
# Ubuntu 22.04 ships yosys 0.9 (2019). eqy needs a yosys generation new enough
# to have the partitioning passes AND it builds a yosys *plugin*
# (eqy_combine.so), which requires the yosys development headers that no distro
# package installs. So yosys is built here with plugin support enabled, and
# eqy is built against that same yosys's yosys-config. Mixing a packaged yosys
# with a source eqy produces a plugin that loads against the wrong ABI.
#
# The commits below are the ones LiveLane actually ran its measurements on
# (configs/pins.env, resolved from the real remotes on 2026-09-03). Pinning
# them means an equivalence verdict from this image is reproducible; floating
# on HEAD would make "proven" a statement about whatever YosysHQ pushed today.
#
# WHY TWO SOLVERS
# ---------------
# The gate's strategy ladder leads with `sby` driving an SMT engine and falls
# through to Yosys's built-in `sat` k-induction for whatever sby leaves
# undecided. That order is a correctness property, not a performance one: `sat`
# returns PASS on sequential partitions that are not equivalent, so leading with
# it admits bad edits. yices2 is the default engine; z3 is installed as a second,
# independently-implemented solver so a suspicious verdict can be re-checked
# with `engine smtbmc z3` rather than trusted. The gate reports a disagreement
# between backends; it never averages them.
ARG BASE_IMAGE=ghcr.io/ucb-bar/chia:latest
FROM ${BASE_IMAGE}

USER root

# Build and run dependencies, in ONE layer with the apt lists removed.
#   libffi-dev    -> yosys ENABLE_PLUGINS; eqy ships a yosys plugin, so this is
#                    NOT optional
#   tcl-dev, libreadline-dev, bison, flex, gawk -> yosys front/back ends
#   libboost-*    -> yosys's optional python/filesystem bits
#   gperf, gmp    -> yices2's configure REQUIRES gperf >= 3.0 and libgmp
#   z3            -> second SMT engine (see header)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        cmake \
        pkg-config \
        bison \
        flex \
        gawk \
        gperf \
        autoconf \
        automake \
        libtool \
        tcl-dev \
        libreadline-dev \
        libffi-dev \
        libgmp-dev \
        zlib1g-dev \
        libboost-filesystem-dev \
        libboost-system-dev \
        libboost-python-dev \
        z3 \
    && rm -rf /var/lib/apt/lists/*

# Every commit here is a pin, not a branch. See the header for why.
ARG YOSYS_REF=22c15a7ecd53437f18f67c72572bd693f78357ca
ARG EQY_REF=4a72eb94fc253062464afee4d0018359017bb846
ARG SBY_REF=b1a1e98cba941ec8433f8dc27f416cd7bb7f14be
ARG YICES_REF=yices-2.7.0

ENV EDA_PREFIX=/opt/eda

# yosys. This generation is CMake-based; `make config-gcc` is gone. abc, fmt,
# cxxopts and the slang front end are SUBMODULES -- without --recursive the
# build either fails or silently produces a yosys with no abc and no
# read_slang, and the gate then errors out on every SystemVerilog design.
RUN git clone https://github.com/YosysHQ/yosys /tmp/yosys \
    && git -C /tmp/yosys checkout --detach ${YOSYS_REF} \
    && git -C /tmp/yosys submodule update --init --recursive --depth 1 \
    && cmake -S /tmp/yosys -B /tmp/yosys/build \
        -DCMAKE_INSTALL_PREFIX=${EDA_PREFIX} \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/yosys/build -j"$(nproc)" \
    && cmake --install /tmp/yosys/build \
    && rm -rf /tmp/yosys \
    # The plugin headers are the reason this build exists at all; if they are
    # missing the eqy build below fails with a confusing compiler error, so
    # fail here instead, where the cause is obvious.
    && test -f ${EDA_PREFIX}/share/yosys/include/kernel/yosys.h \
       || (echo "FATAL: yosys plugin headers absent; eqy cannot build" && false)

# yices2: the SMT engine sby/eqy drive by default.
RUN git clone https://github.com/SRI-CSL/yices2 /tmp/yices2 \
    && git -C /tmp/yices2 checkout --detach ${YICES_REF} \
    && cd /tmp/yices2 \
    && autoconf \
    && ./configure --prefix=${EDA_PREFIX} \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf /tmp/yices2

# sby: eqy's engine driver. Pure Python plus yosys-smtbmc; nothing to compile.
RUN git clone https://github.com/YosysHQ/sby /tmp/sby \
    && git -C /tmp/sby checkout --detach ${SBY_REF} \
    && make -C /tmp/sby install PREFIX=${EDA_PREFIX} \
    && rm -rf /tmp/sby

# eqy LAST: it builds a yosys plugin and must see OUR yosys's yosys-config, not
# a distro one. Passing YOSYS_CONFIG explicitly rather than relying on PATH
# order makes that binding impossible to get wrong later.
RUN git clone https://github.com/YosysHQ/eqy /tmp/eqy \
    && git -C /tmp/eqy checkout --detach ${EQY_REF} \
    && make -C /tmp/eqy -j"$(nproc)" PREFIX=${EDA_PREFIX} \
         YOSYS_CONFIG=${EDA_PREFIX}/bin/yosys-config \
    && make -C /tmp/eqy install PREFIX=${EDA_PREFIX} \
         YOSYS_CONFIG=${EDA_PREFIX}/bin/yosys-config \
    && rm -rf /tmp/eqy

# Register the source-installed shared libraries with the dynamic linker.
#
# NOT optional. yices2 and OpenSTA install .so files into ${EDA_PREFIX}/lib, and
# nothing else puts that directory on the loader's search path -- the host build
# this recipe came from got away with it only because it passed
# `-Wl,-rpath,$PREFIX/lib` in LDFLAGS, which this Dockerfile does not.
# Without this the binaries install successfully and then fail at RUN time with
# "cannot open shared object file", which for the equivalence gate means an
# ERROR verdict: fail-closed, and therefore indistinguishable from a correctly
# cautious gate. ldconfig rather than LD_LIBRARY_PATH so it applies to every
# user and every child process, matching VerilatorRunDockerfile.
RUN printf '%s\n' "${EDA_PREFIX}/lib" "${EDA_PREFIX}/lib64" \
        > /etc/ld.so.conf.d/chia-eda.conf \
    && ldconfig

USER ray
ENV HOME=/home/ray
WORKDIR /home/ray

# APPENDED, not prepended, so the base python/pip stay ahead of it and nothing
# here can perturb the pinned Ray environment that lets this worker join the
# cluster at all.
ENV PATH="${PATH}:/opt/eda/bin"

# Prove the image can do the one thing it exists for, at BUILD time.
#
# A version check is not enough. A worker that cannot actually run a proof
# returns an ERROR verdict, and the gate fails closed -- so a broken image
# looks EXACTLY like a cautious gate and can go unnoticed for a whole
# experiment. This block therefore runs a real proof and a real refutation and
# asserts both, including the per-partition reason that separates "found a
# counterexample" from "could not decide" (eqy gives both the same rc=2).
#
# The fixture is the SAME one chia/formal/test uses, so the image and the unit
# tests cannot drift apart. SMOKE_DIR exists so the build also works from a
# checkout where the package has not been moved into chia/ yet:
#   --build-arg SMOKE_DIR=src/chia_livelane/formal/test/smoke
ARG SMOKE_DIR=chia/formal/test/smoke
COPY ${SMOKE_DIR} /tmp/smoke

USER root
RUN set -eux; \
    eqy --version; \
    sby --version; \
    yosys -V; \
    yosys-abc -q version; \
    yices-smt2 --version; \
    z3 --version; \
    yosys -p "help read_slang" > /dev/null; \
    d=$(mktemp -d); cd "$d"; cp /tmp/smoke/* .; \
    \
    cp equivalent.v gate.v; \
    eqy -d ok -f smoke.eqy > ok.log 2>&1 \
      || { echo "FATAL: a known-equivalent pair was not proved"; \
           tail -40 ok.log; exit 1; }; \
    grep -q "Successfully proved designs equivalent" ok.log \
      || { echo "FATAL: eqy exited 0 without proving anything"; exit 1; }; \
    \
    cp refuted.v gate.v; \
    if eqy -d bad -f smoke.eqy > bad.log 2>&1; then \
      echo "FATAL: a known-buggy design was accepted"; exit 1; \
    fi; \
    grep -q "partitions not equivalent" bad.log \
      || { echo "FATAL: no counterexample found; the solver may be missing"; \
           tail -40 bad.log; exit 1; }; \
    \
    cp refuted_const.v gate.v; \
    if eqy -d const -f smoke.eqy > const.log 2>&1; then \
      echo "FATAL: a stuck-at-constant output was ACCEPTED. The strategy"; \
      echo "ladder in smoke.eqy is listing 'sat' before 'sby': eqy stops at"; \
      echo "the first strategy that decides, and 'sat' returns PASS on"; \
      echo "sequential partitions that are not equivalent."; exit 1; \
    fi; \
    grep -q "partitions not equivalent" const.log \
      || { echo "FATAL: stuck-at-constant refuted for the wrong reason"; \
           tail -40 const.log; exit 1; }; \
    \
    cd /; rm -rf "$d"; \
    echo "chia-eqy: proved a refactor and refuted two bugs; formal stack verified"

# Arbitrary-UID runs: `chia up` starts containers with --user $(id -u):$(id -g)
# and appends a synthetic passwd line at run time, which needs both of these.
RUN chmod -R a+rwX /home/ray && chmod a+rw /etc/passwd
USER ray

# Which chia commit this image carries. Last, so a new revision does not
# invalidate the expensive build layers above.
ARG CHIA_REVISION=unknown
ENV CHIA_REVISION=${CHIA_REVISION}
