# Dockerfile for chia/vlsi/yosys_sta.py workers.
#
# Carries an open-source ASIC QoR stack: yosys + ABC for technology mapping and
# OpenSTA for static timing. CHIA's only existing logic-synthesis-to-netlist
# path is Cadence Genus, which needs a licence server; this image lets a CHIA
# flow report cells, area and critical path with no licence at all, which is
# what makes such a result reproducible by a reviewer.
#
# Builds ON TOP of ghcr.io/ucb-bar/chia (rayproject/ray + the chia package), so
# chia and a matching Ray/Python are already installed.
#
#   docker build -f dockerfiles/YosysStaDockerfile \
#       -t ghcr.io/ucb-bar/chia-yosys-sta:latest .
#
# Bind it to the node with the resource token, which is the ONLY link between a
# @ChiaFunction and a container image:
#
#   available_node_types:
#     yosys_sta_worker:
#       resources: {"yosys_sta": 1}
#       docker:
#         image: "ghcr.io/ucb-bar/chia-yosys-sta:latest"
#         run_options: ["-v", "/path/to/pdk:/pdk:ro"]   # see NO PDK below
#
#   @ChiaFunction(resources={"yosys_sta": 1})   # chia/vlsi/yosys_sta.py
#   def yosys_sta_qor(...)
#
# Smoke-test a built image:
#   docker run --rm ghcr.io/ucb-bar/chia-yosys-sta:latest \
#       bash -lc 'yosys -V && echo exit | sta -no_splash'
#
# NO PDK IS BAKED IN, deliberately
# --------------------------------
# yosys_sta_qor takes `liberty` as an argument, and two area or delay numbers
# are only comparable if they came from the SAME Liberty file. Baking one in
# would invite exactly the comparison that is not valid -- results from an
# image-default PDK silently compared against results from a mounted one -- and
# would add gigabytes to every pull. Mount the PDK read-only (see run_options
# above) and pass the .lib path to the node.
#
# WHY FROM SOURCE
# ---------------
# Ubuntu 22.04 ships yosys 0.9 (2019), whose `stat -liberty` output format and
# ABC integration differ from what this node's parsers are written against, and
# it ships no OpenSTA at all. Both are therefore built from pinned commits --
# the ones LiveLane ran its measurements on (configs/pins.env, resolved from
# the real remotes on 2026-09-03) -- so a QoR number from this image is
# reproducible rather than a statement about whatever upstream pushed today.
#
# CUDD is built from source because it is in no Ubuntu repository and OpenSTA
# REQUIRES it (OpenSTA README: conditional timing arcs, constant propagation
# and power activity propagation are all BDD-backed). Eigen, SWIG and TCL come
# from apt, which satisfies OpenSTA's find_package(Eigen3 REQUIRED),
# find_package(SWIG 3.0 REQUIRED) and its TCL binding generation.
ARG BASE_IMAGE=ghcr.io/ucb-bar/chia:latest
FROM ${BASE_IMAGE}

USER root

# Build and run dependencies, in ONE layer with the apt lists removed.
#   libeigen3-dev -> OpenSTA find_package(Eigen3 REQUIRED)
#   swig          -> OpenSTA find_package(SWIG 3.0 REQUIRED); generates the TCL
#                    bindings that ARE the sta CLI
#   tcl-dev       -> that same CLI
#   libffi-dev    -> yosys plugin support, so this image can also load plugins
#   bison/flex/gawk, libreadline-dev -> yosys front/back ends
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        cmake \
        pkg-config \
        bison \
        flex \
        gawk \
        autoconf \
        automake \
        libtool \
        swig \
        libeigen3-dev \
        tcl-dev \
        libreadline-dev \
        libffi-dev \
        zlib1g-dev \
        libboost-filesystem-dev \
        libboost-system-dev \
        libboost-python-dev \
    && rm -rf /var/lib/apt/lists/*

ARG YOSYS_REF=22c15a7ecd53437f18f67c72572bd693f78357ca
ARG OPENSTA_REF=737b52f33b66e4c2ccc3e3ef22c3adfe9aec8d09
ARG CUDD_REF=cudd-3.0.0

ENV EDA_PREFIX=/opt/eda

# yosys. This generation is CMake-based; `make config-gcc` is gone. abc, fmt,
# cxxopts and the slang front end are SUBMODULES -- without --recursive the
# build either fails or silently produces a yosys with NO abc, and every
# synthesis run then reports cells=None in milliseconds and looks like a fast
# success rather than a broken image.
RUN git clone https://github.com/YosysHQ/yosys /tmp/yosys \
    && git -C /tmp/yosys checkout --detach ${YOSYS_REF} \
    && git -C /tmp/yosys submodule update --init --recursive --depth 1 \
    && cmake -S /tmp/yosys -B /tmp/yosys/build \
        -DCMAKE_INSTALL_PREFIX=${EDA_PREFIX} \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/yosys/build -j"$(nproc)" \
    && cmake --install /tmp/yosys/build \
    && rm -rf /tmp/yosys

# CUDD: a REQUIRED OpenSTA dependency, in no Ubuntu repository. Built PIC
# because OpenSTA links it into a shared library; CUDD 3.0.0 predates modern
# autoconf, so regenerate rather than trusting the shipped configure.
RUN git clone https://github.com/cuddorg/cudd /tmp/cudd \
    && git -C /tmp/cudd checkout --detach ${CUDD_REF} \
    && cd /tmp/cudd \
    && (autoreconf -fi || true) \
    && ./configure --prefix=${EDA_PREFIX} --enable-shared --enable-obj \
        CFLAGS="-fPIC -O2" CXXFLAGS="-fPIC -O2" \
    && make -j"$(nproc)" \
    && make install \
    # CUDD's install omits the internal headers OpenSTA's FindCUDD looks for.
    && for h in cudd/cudd.h config.h util/util.h mtr/mtr.h epd/epd.h; do \
         [ -f "/tmp/cudd/$h" ] && cp "/tmp/cudd/$h" ${EDA_PREFIX}/include/ || true; \
       done \
    && rm -rf /tmp/cudd

# OpenSTA.
RUN git clone https://github.com/parallaxsw/OpenSTA /tmp/OpenSTA \
    && git -C /tmp/OpenSTA checkout --detach ${OPENSTA_REF} \
    && cmake -S /tmp/OpenSTA -B /tmp/OpenSTA/build \
        -DCMAKE_INSTALL_PREFIX=${EDA_PREFIX} \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH=${EDA_PREFIX} \
        -DCUDD_DIR=${EDA_PREFIX} \
    && cmake --build /tmp/OpenSTA/build -j"$(nproc)" \
    && cmake --install /tmp/OpenSTA/build \
    && rm -rf /tmp/OpenSTA

# Register the source-installed shared libraries with the dynamic linker.
#
# NOT optional. yices2 and OpenSTA install .so files into ${EDA_PREFIX}/lib, and
# nothing else puts that directory on the loader's search path -- the host build
# this recipe came from got away with it only because it passed
# `-Wl,-rpath,$PREFIX/lib` in LDFLAGS, which this Dockerfile does not.
# Without this the binaries install successfully and then fail at RUN time with
# "cannot open shared object file", which for the equivalence gate means an
# ERROR verdict: fail-closed, and therefore indistinguishable from a correctly
# cautious gate. ldconfig rather than LD_LIBRARY_PATH so it applies to every
# user and every child process, matching VerilatorRunDockerfile.
RUN printf '%s\n' "${EDA_PREFIX}/lib" "${EDA_PREFIX}/lib64" \
        > /etc/ld.so.conf.d/chia-eda.conf \
    && ldconfig

USER ray
ENV HOME=/home/ray
WORKDIR /home/ray

# APPENDED, not prepended, so the base python/pip stay ahead of it and nothing
# here can perturb the pinned Ray environment that lets this worker join the
# cluster at all.
ENV PATH="${PATH}:/opt/eda/bin"

# Prove the image can do the one thing it exists for, at BUILD time, by
# running a real synthesis AND a real timing analysis. An image whose ABC is
# missing reports cells=None in milliseconds, which reads as a fast success;
# an OpenSTA that built no timing arcs says "No paths found" and exits 0.
# Both of those pass a version-check smoke test, so this one maps and times a
# design instead.
#
# The fixture is the SAME one chia/vlsi/tests uses, so the image and the unit
# tests cannot drift apart. SMOKE_DIR exists so the build also works from a
# checkout where the package has not been moved into chia/ yet:
#   --build-arg SMOKE_DIR=src/chia_livelane/vlsi/tests/smoke
ARG SMOKE_DIR=chia/vlsi/tests/smoke
COPY ${SMOKE_DIR} /tmp/smoke

USER root
RUN set -eux; \
    yosys -V; \
    yosys-abc -q version; \
    echo exit | sta -no_splash; \
    d=$(mktemp -d); cd "$d"; cp /tmp/smoke/smoke.lib /tmp/smoke/smoke.v .; \
    yosys -q -p "read_verilog smoke.v; synth -top smoke_top; \
dfflibmap -liberty smoke.lib; abc -liberty smoke.lib; opt_clean; \
tee -o stat.txt stat -liberty smoke.lib; write_verilog -noattr mapped.v"; \
    grep -q "Chip area" stat.txt \
      || { echo "FATAL: no area reported -- is ABC present?"; exit 1; }; \
    printf 'read_liberty smoke.lib\nread_verilog mapped.v\n' > t.tcl; \
    printf 'link_design smoke_top\n' >> t.tcl; \
    printf 'create_clock -name clk -period 10 [get_ports clk]\n' >> t.tcl; \
    printf 'report_checks -path_delay max -digits 4\nexit\n' >> t.tcl; \
    sta -no_splash -exit t.tcl | tee sta.txt; \
    grep -q "data arrival time" sta.txt \
      || { echo "FATAL: OpenSTA reported no timed path"; exit 1; }; \
    grep -q "slack" sta.txt \
      || { echo "FATAL: OpenSTA reported no slack"; exit 1; }; \
    cd /; rm -rf "$d"; \
    echo "chia-yosys-sta: synthesis and timing verified end to end"

# Arbitrary-UID runs: `chia up` starts containers with --user $(id -u):$(id -g)
# and appends a synthetic passwd line at run time, which needs both of these.
RUN chmod -R a+rwX /home/ray && chmod a+rw /etc/passwd
USER ray

# Which chia commit this image carries. Last, so a new revision does not
# invalidate the expensive build layers above.
ARG CHIA_REVISION=unknown
ENV CHIA_REVISION=${CHIA_REVISION}
